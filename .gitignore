# =============================================================================
# Terraform
# =============================================================================

# Local .terraform directories (provider binaries, modules)
**/.terraform/

# Terraform state files (contain sensitive data, managed remotely in production)
*.tfstate
*.tfstate.*

# Terraform lock info (transient, created during apply)
.terraform.tfstate.lock.info

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform override files (local-only customisations)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI config
.terraformrc
terraform.rc

# =============================================================================
# Python
# =============================================================================

# Hypothesis test database (generated during property-based testing)
.hypothesis/

# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Distribution / packaging
*.egg-info/
dist/
build/

# =============================================================================
# Docker
# =============================================================================

# Ignore local docker-compose overrides
docker-compose.override.yml

# =============================================================================
# IDE / Editor
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/

# Vim
*.swp
*.swo
*~

# =============================================================================
# OS
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Misc
# =============================================================================

# Environment files (may contain secrets)
.env
.env.*
!.env.example
